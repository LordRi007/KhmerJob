{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "khmer-job-matcher/frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "khmer-job-matcher/backend",
      "entrypoint": "main:app"
    },
    "sentinelai_starter": {
      "root": "SentinelAI_Starter",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/docs",
      "destination": { "service": "backend" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
